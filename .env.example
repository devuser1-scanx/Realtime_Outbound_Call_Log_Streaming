# GCP
GCP_PROJECT_ID=vernal-maker-473121-k4
PUBSUB_TOPIC=call-events-debug

# Cloud SQL
INSTANCE_CONNECTION_NAME=vernal-maker-473121-k4:us-central1:XXX
DB_NAME=XXX
DB_USER=outbound_call_streaming
# DB_PASSWORD=<local only; on Cloud Run this comes from Secret Manager>
DB_PASSWORD=

# Streaming behaviour
START_AFTER_CALL_LOG_ID=<SELECT MAX(id) FROM call_logs at go-live>
EXCLUDED_STAFF=clinic-tablet
POLL_INTERVAL_SECONDS=1
BATCH_SIZE=500
LOOKBACK_ROWS=1000

# Misc
LOG_LEVEL=INFO